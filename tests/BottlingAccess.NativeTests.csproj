<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BottlingAccess.NativeTests.cs" />
    <Compile Include="../src/DeepSpaceQoL/BottlingAccess.cs" Link="BottlingAccess.cs" />
    <Compile Include="../src/DeepSpaceQoL/BottlingCatalog.cs" Link="BottlingCatalog.cs" />
    <Compile Include="../src/DeepSpaceQoL/BottlingService.cs" Link="BottlingService.cs" />
    <Compile Include="../src/DeepSpaceQoL/StorageCatalog.cs" Link="StorageCatalog.cs" />
    <Compile Include="../src/DeepSpaceQoL/StorageRules.cs" Link="StorageRules.cs" />
    <Compile Include="../src/DeepSpaceQoL/Core/StoragePolicy.cs" Link="StoragePolicy.cs" />
    <Compile Include="../src/DeepSpaceQoL/Core/LiquidQualityPolicy.cs" Link="LiquidQualityPolicy.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
